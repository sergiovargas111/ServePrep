# Environment variables declared in this file are NOT automatically loaded by Prisma.
# prisma.config.ts imports "dotenv/config" so they are loaded when running Prisma CLI commands.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://user:password@localhost:5432/serveprep?schema=public"

# Auth.js (NextAuth) — sign-in session/JWT signing secret.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"
