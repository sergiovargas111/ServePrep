// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(cuid())
  name           String?
  email          String   @unique
  hashedPassword String
  createdAt      DateTime @default(now())

  scenarioResults  ScenarioResult[]
  flashcardReviews FlashcardReview[]
}

model ScenarioResult {
  id         String   @id @default(cuid())
  userId     String
  scenarioId String
  correct    Boolean
  timestamp  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Mirrors the CardSchedule shape in src/lib/spaced-repetition.ts — one row
// per (user, card) pair holding that card's current SM-2 schedule.
model FlashcardReview {
  id           String   @id @default(cuid())
  userId       String
  cardId       String
  easeFactor   Float
  intervalDays Int
  repetitions  Int
  dueDate      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId])
}

// Caches Perplexity menu lookups so the same restaurant/location isn't
// re-queried on every request. restaurantName/location are stored
// normalized (trimmed + lowercased) by the caching layer, so the unique
// constraint actually catches equivalent-but-differently-cased lookups.
model MenuCache {
  id             String   @id @default(cuid())
  restaurantName String
  location       String
  dishes         Json
  fetchedAt      DateTime @default(now())

  @@unique([restaurantName, location])
}
